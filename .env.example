# ---------------------------------------------
# Секреты freelance-lead-parser — СКОПИРУЙ этот файл в .env и заполни.
# Сам .env в .gitignore — в репозиторий не коммитим.
# ---------------------------------------------

# Telegram API (my.telegram.org -> API development tools)
API_ID=
API_HASH=

# Строка user-сессии Telethon (генерится generate_session.py на Фазе 6)
TELEGRAM_SESSION=

# Токен бота от @BotFather
# (старый токен из образца считаем скомпрометированным — отозвать, вписать новый)
BOT_TOKEN=

# Числовой id Давида — адрес, куда бот шлёт найденные заказы
MY_TELEGRAM_ID=
